    "openai": "^7.5.0",
    "pg": "^8.13.1",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/sharp": "^0.31.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
