{
  "name": "jodtang-backend",
  "version": "1.0.0",
  "description": "จดตัง (JodTang) - Personal finance and expense tracking assistant LINE Bot",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "test:webhook": "tsx scripts/simulate-webhook.ts",
    "test:extraction": "tsx scripts/test-extraction.ts",
    "test:slip": "tsx scripts/test-slip-pipeline.ts",
    "test:security": "tsx scripts/test-security-hardening.ts",
    "test:security-faq": "tsx scripts/test-security-faq.ts",
    "test:date": "tsx scripts/test-date-parser.ts",
    "test:tx-mgmt": "tsx scripts/test-transaction-management.ts",
    "test:export-csv": "tsx scripts/test-export-csv.ts",
    "test:announcement": "tsx scripts/test-export-csv-announcement.ts",
    "test:migration-gate": "tsx scripts/test-disposable-migration-gate.ts",
    "test:query-contract": "tsx scripts/test-query-intent-contract.ts",
    "test:query-engine": "tsx scripts/test-query-engine.ts",
    "test:query-formatter": "tsx scripts/test-query-formatter.ts",
    "test:query-golden": "tsx scripts/test-query-golden-dataset.ts",
    "test:integration": "tsx scripts/test-realworld-integration.ts",
    "test:ux-menu": "tsx scripts/test-ux-menu.ts",
    "test:slip2go": "tsx scripts/test-slip2go-adapter.ts",
    "test:slip-integration": "tsx scripts/test-slip-pipeline-integration.ts",
    "test:regression:raw": "npm run test:extraction && npm run test:slip && npm run test:security && npm run test:security-faq && npm run test:date && npm run test:tx-mgmt && npm run test:export-csv && npm run test:announcement && npm run test:query-contract && npm run test:query-engine && npm run test:query-formatter && npm run test:query-golden && npm run test:integration && npm run test:ux-menu && npm run test:slip2go && npm run test:slip-integration",
    "test:regression": "tsx scripts/run-isolated-regression.ts",
    "test:isolation": "tsx scripts/run-isolated-regression.ts",
    "test": "npm run test:regression",
    "benchmark:ai": "tsx scripts/benchmark-ai.ts",
    "benchmark:query": "tsx scripts/test-query-golden-dataset.ts",
    "announce:export-csv": "tsx scripts/send-export-csv-announcement.ts"
  },
  "keywords": [
    "line-bot",
    "finance",
    "expense-tracker",
    "postgresql",
    "typescript"
