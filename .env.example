# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL=
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# LINE Bot Configuration
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Public export URL (required in production unless the platform provides RENDER_EXTERNAL_URL)
PUBLIC_BASE_URL=
# Optional dedicated secret for short-lived CSV download tokens.
# If omitted, the LINE channel secret is used as the key material.
EXPORT_TOKEN_SECRET=

# AI / OpenAI / OpenRouter / DeepSeek Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Slip Verification (Slip2Go API Connect)
SLIP2GO_API_SECRET=
SLIP2GO_BASE_URL=https://connect.slip2go.com

# Reserved future slip-provider integration; not used by Sprint 1 image handling.
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=
